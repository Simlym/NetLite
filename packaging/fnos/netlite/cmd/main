#!/bin/bash
set -eu
umask 077
: "${TRIM_APPDEST:?}" "${TRIM_PKGVAR:?}" "${TRIM_PKGETC:?}"
PID_FILE="$TRIM_PKGVAR/netlite.pid"
BIN="$TRIM_APPDEST/bin/netlite"
SOCKET="$TRIM_APPDEST/netlite.sock"
# Default access is restricted to the package user and root. If the fnOS
# gateway uses another identity, explicitly grant only its verified group.
SOCKET_MODE=0600
SOCKET_GROUP=-1
configure_socket() {
if [ -f "$TRIM_PKGETC/gateway-socket.conf" ]; then
 while IFS='=' read -r key value; do
  case "$key" in
   mode) SOCKET_MODE="$value" ;;
   group) SOCKET_GROUP="$value" ;;
   ''|'#'*) ;;
   *) echo 'Invalid gateway-socket.conf key.' >&2; exit 1 ;;
  esac
 done < "$TRIM_PKGETC/gateway-socket.conf"
fi
case "$SOCKET_MODE" in 0600|0660) ;; *) echo 'Socket mode must be 0600 or 0660.' >&2; exit 1 ;; esac
[[ "$SOCKET_GROUP" == -1 || "$SOCKET_GROUP" =~ ^[0-9]+$ ]] || exit 1
}
running() {
 [ -f "$PID_FILE" ] || return 1
 pid=$(cat "$PID_FILE")
 [[ "$pid" =~ ^[0-9]+$ ]] || return 1
 [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$BIN" ] && kill -0 "$pid" 2>/dev/null
}
health() {
 "$BIN" gateway-health --gateway-socket "$SOCKET" >/dev/null 2>&1
}
case "${1:-}" in
 start)
  running && exit 0
  configure_socket
  mkdir -p "$TRIM_PKGVAR" "$TRIM_PKGETC"
  nohup "$BIN" --auth-mode fnos-gateway --gateway-socket "$SOCKET" --gateway-socket-mode "$SOCKET_MODE" --gateway-socket-group "$SOCKET_GROUP" --data "$TRIM_PKGVAR" --web "$TRIM_APPDEST/web" --caddy "$TRIM_APPDEST/bin/caddy" --caddy-admin 127.0.0.1:20190 >> "$TRIM_PKGVAR/netlite.log" 2>&1 < /dev/null &
  echo "$!" > "$PID_FILE"
  for i in {1..10}; do
   sleep 1
   if ! running; then
    echo 'NetLite 启动失败，请查看应用数据目录 netlite.log / caddy.log。' > "$TRIM_TEMP_LOGFILE"
    exit 1
   fi
   if health; then exit 0; fi
  done
  kill -TERM "$(cat "$PID_FILE")" || true
  echo 'NetLite 启动超时。' > "$TRIM_TEMP_LOGFILE"
  exit 1
  ;;
 stop)
  if running; then
   kill -TERM "$pid"
   for i in {1..20}; do running || break; sleep 1; done
   if running; then
    echo 'NetLite 未能正常停止，请查看日志；未强杀进程以避免遗留 Caddy。' > "$TRIM_TEMP_LOGFILE"
    exit 1
   fi
  fi
  rm -f "$PID_FILE"
  ;;
 status) running && exit 0; exit 3 ;;
 *) exit 1 ;;
esac

