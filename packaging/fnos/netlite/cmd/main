#!/bin/bash
set -eu
umask 077
: "${TRIM_APPDEST:?}" "${TRIM_PKGVAR:?}" "${TRIM_PKGETC:?}"
PID_FILE="$TRIM_PKGVAR/netlite.pid"
BIN="$TRIM_APPDEST/bin/netlite"
running() {
 [ -f "$PID_FILE" ] || return 1
 pid=$(cat "$PID_FILE")
 [[ "$pid" =~ ^[0-9]+$ ]] || return 1
 [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$BIN" ] && kill -0 "$pid" 2>/dev/null
}
health() {
 (
  exec 3<>/dev/tcp/127.0.0.1/18780 || exit 1
  printf 'GET /healthz HTTP/1.0\r\nHost: localhost\r\n\r\n' >&3
  IFS= read -r -t 1 response <&3
  [[ "$response" == *" 200 "* ]]
 ) 2>/dev/null
}
case "${1:-}" in
 start)
  running && exit 0
  mkdir -p "$TRIM_PKGVAR" "$TRIM_PKGETC"
  nohup "$BIN" --auth-mode token --listen 0.0.0.0:18780 --data "$TRIM_PKGVAR" --web "$TRIM_APPDEST/web" --caddy "$TRIM_APPDEST/bin/caddy" --caddy-admin 127.0.0.1:20190 >> "$TRIM_PKGVAR/netlite.log" 2>&1 < /dev/null &
  echo "$!" > "$PID_FILE"
  for i in {1..10}; do
   sleep 1
   if ! running; then
    echo 'NetLite 启动失败，请查看应用数据目录 netlite.log / caddy.log。' > "$TRIM_TEMP_LOGFILE"
    exit 1
   fi
   if health; then exit 0; fi
  done
  kill -TERM "$(cat "$PID_FILE")" || true
  echo 'NetLite 启动超时。' > "$TRIM_TEMP_LOGFILE"
  exit 1
  ;;
 stop)
  if running; then
   kill -TERM "$pid"
   for i in {1..20}; do running || break; sleep 1; done
   if running; then
    echo 'NetLite 未能正常停止，请查看日志；未强杀进程以避免遗留 Caddy。' > "$TRIM_TEMP_LOGFILE"
    exit 1
   fi
  fi
  rm -f "$PID_FILE"
  ;;
 status) running && exit 0; exit 3 ;;
 *) exit 1 ;;
esac

