package config

import("bytes";"io";"net/http";"strings";"testing")
type netliteFakeTransport struct{}
func(netliteFakeTransport)RoundTrip(r *http.Request)(*http.Response,error){return &http.Response{StatusCode:200,Body:io.NopCloser(strings.NewReader("secret-response")),Header:make(http.Header)},nil}
func TestNetLiteBridge(t *testing.T){
 cases:=[]struct{provider,method,url,header,want string}{
 {"cloudflare","POST","https://api.invalid/records","","create"},
 {"cloudflare","PATCH","https://api.invalid/records/1","","update"},
 {"cloudflare","GET","https://api.invalid/records","","query"},
 {"dnspod","POST","https://api.invalid/Record.Modify","","update"},
 {"dnspod","POST","https://api.invalid/Record.Create","","create"},
 {"dnspod","POST","https://api.invalid/Record.List","","query"},
 {"tencentcloud","POST","https://api.invalid","ModifyRecord","update"},
 {"tencentcloud","POST","https://api.invalid","CreateRecord","create"},
 {"tencentcloud","POST","https://api.invalid","DescribeRecordList","query"},
 {"alidns","GET","https://api.invalid/?Action=UpdateDomainRecord&Signature=secret-signature","","update"},
 {"alidns","GET","https://api.invalid/?Action=AddDomainRecord","","create"},
 {"alidns","GET","https://api.invalid/?Action=DescribeSubDomainRecords","","query"},
 }
 var output bytes.Buffer;previous:=netliteOutput;netliteOutput=&output;defer func(){netliteOutput=previous}()
 for _,c:=range cases{r,_:=http.NewRequest(c.method,c.url,strings.NewReader("secret-body"));r.Header.Set("Authorization","secret-token");r.Header.Set("X-TC-Action",c.header);if got:=netliteAction(c.provider,r);got!=c.want{t.Fatalf("%s: %s",c.provider,got)};NetLiteBegin(&DnsConfig{});client:=NetLiteObserveClient(&http.Client{Transport:netliteFakeTransport{}},c.provider);resp,e:=client.Do(r);if e!=nil{t.Fatal(e)};resp.Body.Close();want:=0;if c.want!="query"{want=1};if netliteRequests!=1||netliteUpdates!=want{t.Fatal("request count mismatch")}}
 if strings.Contains(output.String(),"secret")||strings.Contains(output.String(),"api.invalid"){t.Fatal("request data leaked into events")}
 for _,c:=range []struct{enabled bool;ip string;domains []*Domain;want string}{
 {false,"",nil,"disabled"},{true,"",nil,"ip_failed"},{true,"192.0.2.1",nil,"invalid_domain"},{true,"192.0.2.1",[]*Domain{{}},"unchanged"},{true,"192.0.2.1",[]*Domain{{UpdateStatus:UpdatedSuccess}},"success"},{true,"192.0.2.1",[]*Domain{{UpdateStatus:UpdatedSuccess},{UpdateStatus:UpdatedFailed}},"failed"},
 }{if got:=netliteResult(c.enabled,c.ip,c.domains);got!=c.want{t.Fatalf("result %s want %s",got,c.want)}}
}
