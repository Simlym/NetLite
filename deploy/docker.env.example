# Copy to .env beside compose.yaml. Prefer a tested version or sha tag in production.
NETLITE_IMAGE=ghcr.io/simlym/netlite:main
NETLITE_MANAGEMENT_BIND=127.0.0.1

# Bridge only: external entry ports; the UI shows these instead of container ports.
# Set NETLITE_HTTPS_PORT=443 for https://your-domain without an explicit port.
NETLITE_HTTP_PORT=18080
NETLITE_HTTPS_PORT=18443
# After adding custom ports to compose.yaml, declare them here with a leading comma.
# NETLITE_EXTRA_PORT_MAPPINGS=,8443:8443

# Local builds default to these mirrors; only used with compose.build.yaml.
# NETLITE_BUILD_REGISTRY=docker.m.daocloud.io
# NETLITE_BUILDKIT_SYNTAX=docker.m.daocloud.io/docker/dockerfile:1
# NETLITE_GOPROXY=https://goproxy.cn
