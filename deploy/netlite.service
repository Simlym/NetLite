[Unit]
Description=NetLite network manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netlite
Group=netlite
WorkingDirectory=/opt/netlite
Environment=NETLITE_LISTEN=0.0.0.0:18780
EnvironmentFile=-/etc/netlite/netlite.env
ExecStart=/opt/netlite/bin/netlite --auth-mode local --listen ${NETLITE_LISTEN} --data /var/lib/netlite --caddy /opt/netlite/bin/caddy
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/netlite
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

