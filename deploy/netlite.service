[Unit]
Description=NetLite network manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netlite
Group=netlite
WorkingDirectory=/opt/netlite
EnvironmentFile=-/etc/netlite/credentials.env
ExecStart=/opt/netlite/bin/netlite --listen 127.0.0.1:18780 --data /var/lib/netlite --web /opt/netlite/web --caddy /opt/netlite/bin/caddy
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/netlite
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
